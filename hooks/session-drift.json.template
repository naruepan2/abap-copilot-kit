{
  // TEMPLATE — copy to ~/.copilot/hooks/session-drift.json (%USERPROFILE%\.copilot\hooks\
  // on Windows) and replace {{COPILOT_HOME}} with your own Copilot folder.
  //
  // Windows:  "node \"C:\\Users\\<you>\\.copilot\\hooks\\session-drift.cjs\""
  // macOS / Linux: "node \"$HOME/.copilot/hooks/session-drift.cjs\""
  //
  // Use JSON escaping for the backslashes. The command runs in a shell, so the path
  // must be quoted because it can contain spaces.
  //
  // The script is a detection-only sessionStart hook:
  //   - reads agents/, both skill roots, mcp.json, extension manifests, roster.json
  //   - compares against the previous snapshot in ~/.copilot/state/surface.json
  //   - returns {} when nothing changed, so an unchanged session pays no context cost
  //   - returns additionalContext listing only what changed
  // It never edits an agent, skill, or config file.
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "command": "node \"{{COPILOT_HOME}}\\hooks\\session-drift.cjs\"",
        "timeoutSec": 15
      }
    ]
  }
}
