{
  // TEMPLATE — copy to %APPDATA%\Code\User\mcp.json, then replace every {{PLACEHOLDER}}.
  // This file is JSONC so the comments below survive review; strip them before use
  // if your editor refuses comments.
  //
  // Security notes:
  // - Never commit the filled-in file. It contains a real hostname, SAP user, and CA path.
  // - Passwords belong in the "inputs" block as promptString with password: true,
  //   referenced as ${input:<id>}. Do not paste a password into "env".
  // - Prefer NODE_EXTRA_CA_CERTS with a real CA bundle over SAP_INSECURE=true.
  //   SAP_INSECURE=true accepts any certificate and masks a man-in-the-middle.
  "inputs": [
    {
      "id": "sap-password",
      "type": "promptString",
      "description": "SAP password for {{SAP_USER}} (client {{SAP_CLIENT}}) used by the arc-1 MCP server.",
      "password": true
    }
  ],
  "servers": {
    // ARC-1 — intent-based ADT server. Start it through the local launcher: it resolves the
    // connection (URL, client, user) from arc1-connections.json and the password from Windows
    // Credential Manager. Do NOT put SAP_URL/SAP_USER/SAP_PASSWORD here — a second logon then needs
    // no config edit. Absolute powershell.exe path matters: a bare "powershell" fails on a trimmed PATH.
    "arc-1": {
      "type": "stdio",
      "command": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
      "args": [
        "-NoProfile", "-ExecutionPolicy", "Bypass", "-File",
        "C:\\Users\\<you>\\.copilot\\state\\sap-arc1-launcher.ps1",
        "-Connection", "<connection name from arc1-connections.json>"
      ],
      "env": {
        "SAP_INSECURE": "false",
        "NODE_EXTRA_CA_CERTS": "{{CA_BUNDLE_PATH}}",
        "SAP_ALLOW_WRITES": "true",
        "SAP_ALLOWED_PACKAGES": "$TMP,Z*,Y*",
        "SAP_ALLOW_TRANSPORT_WRITES": "true",
        "SAP_ALLOW_DATA_PREVIEW": "false",
        "SAP_ALLOW_FREE_SQL": "false",
        "SAP_ALLOW_GIT_WRITES": "false"
      }
    },

    // Optional: SAP AI Dev Toolkit destination-scoped server.
    // Generated by `sap-ai-dev --setup`; the env shape below is the local SAP GUI form.
    // Omit this block entirely if you do not use the toolkit.
    "gsd-120": {
      "type": "stdio",
      "command": "{{TOOLKIT_CMD}}",
      "env": {
        "SAP_ALLOW_TRANSPORTABLE_EDITS": "true",
        "SAP_AI_DEV_TOOLKIT_DESTINATION_SOURCE": "sap-gui-local",
        "SAP_AI_DEV_TOOLKIT_DESTINATION": "{{DESTINATION_NAME}}",
        "SAP_URL": "https://{{SAP_HOST}}:{{SAP_PORT}}",
        "SAP_CLIENT": "{{SAP_CLIENT}}",
        "SAP_SYSTEM_ID": "{{SAP_SID}}",
        "SAP_AUTH_MODE": "basic",
        "SAP_USER": "{{SAP_USER}}",
        "SAP_PASSWORD": "${input:sap-password}",
        "SAP_TLS_SERVER_NAMES": "{{SAP_HOST}}",
        "SAP_TLS_CA_FILE": "{{CA_BUNDLE_PATH}}",
        "SAP_AI_DEV_TOOLKIT_TLS_CA_FILE": "{{CA_BUNDLE_PATH}}",
        "NODE_EXTRA_CA_CERTS": "{{CA_BUNDLE_PATH}}"
      },
      "BAS_EXT": "true"
    },

    // Public, read-only SAP documentation. No key or login. Declare in VS Code mcp.json only;
    // do not copy the same key into ~/.copilot/mcp-config.json (see verify-all section 8b).
    "sap-abap-docs": {
      "type": "http",
      "url": "https://mcp-abap.marianzeis.de/mcp"
    }
  }
}
