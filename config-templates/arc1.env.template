# arc1.env.template - copy to %USERPROFILE%\.copilot\state\arc1.env and fill in.
#
# This file is a TEMPLATE. The copy you actually use lives outside every repository, so it can
# never be committed. Fill the copy, never this one.
#
# Two kinds of line:
#   KEY=<value>     plaintext, not a secret
#   KEY=@secret     resolved from Windows Credential Manager at launch, never written here
#
# To store a @secret value (you type it; it is not echoed and does not enter any chat):
#   powershell -ExecutionPolicy Bypass -File sap-secret.ps1 -Set -Key SAP_PASSWORD
#
# Any variable ARC-1 reads can be added here. The launcher parses the file and does not need
# editing, so a new ARC-1 setting costs one line.

# --- connection (not secret) -------------------------------------------------
SAP_URL=https://<host>:<port>
SAP_CLIENT=<client>
SAP_USER=<sap user id>
SAP_LANGUAGE=EN

# --- secrets (@secret) -------------------------------------------------------
# ARC-1 reads these as secrets. Keep every one of them as @secret, never as plaintext.
SAP_PASSWORD=@secret
# SAP_COOKIE_STRING=@secret
# SAP_BTP_SERVICE_KEY=@secret
# ARC1_API_KEYS=@secret

# --- TLS ---------------------------------------------------------------------
# A private CA bundle, if the SAP certificate does not chain to a public root.
# NODE_EXTRA_CA_CERTS=<absolute path to your CA bundle .crt>
# Never set SAP_INSECURE=true: it accepts any certificate and hides a man in the middle.
SAP_INSECURE=false

# --- capabilities ------------------------------------------------------------
# These enable writes. Keep them only if this harness is meant to write to SAP.
SAP_ALLOW_WRITES=false
SAP_ALLOW_TRANSPORT_WRITES=false
SAP_ALLOW_DATA_PREVIEW=false
SAP_ALLOW_FREE_SQL=false
SAP_ALLOW_GIT_WRITES=false
